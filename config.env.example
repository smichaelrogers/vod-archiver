# =============================================================================
#  Twitch VOD Archiver — configuration
#  Copy this file to `config.env` and edit it:   cp config.env.example config.env
#  After editing, apply changes with:            ./scripts/setup.sh
#  (or only re-sync channels with:               ./scripts/sync-channels.sh)
# =============================================================================

# ---- Where archived VODs are saved -----------------------------------------
# Any directory / mounted drive. Created if missing. Absolute path required.
ARCHIVE_DIR=/mnt/archive/twitch

# ---- Which streams to archive ----------------------------------------------
# Comma-separated Twitch URLs (or bare channel names).
# Example: STREAM_URLS=https://www.twitch.tv/zibbp,https://twitch.tv/staysafetv
STREAM_URLS=https://www.twitch.tv/CHANNEL_NAME

# ---- Twitch application (required by Ganymede) -----------------------------
# Create one at https://dev.twitch.tv/console/apps/create
#   OAuth Redirect URL: http://localhost   Category: Application Integration
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---- What to archive --------------------------------------------------------
# Quality: best | 1440p | 1080p | 720p | 480p | 360p | 160p | audio
QUALITY=best
# Record streams while they are live.
ARCHIVE_LIVE=true
# Also download past broadcasts (VODs) that weren't recorded live — catches
# streams missed while the PC was asleep/off.
ARCHIVE_VODS=true
# Only download VODs newer than this many days (0 = no limit; beware big backfills).
VOD_MAX_AGE_DAYS=7
# Save chat as JSON (cheap) / render chat to a video (CPU heavy — keep false).
ARCHIVE_CHAT=true
RENDER_CHAT=false

# ---- Resource usage ---------------------------------------------------------
# How often (seconds) Ganymede checks watched channels for live streams.
LIVE_CHECK_INTERVAL=300
# Hard caps for the containers.
GANYMEDE_CPUS=1.5
GANYMEDE_MEMORY=1g
DB_CPUS=0.5
DB_MEMORY=256m

# ---- Sleep / power ----------------------------------------------------------
# Keep the PC awake while post-processing (remux to MP4, chat download) after a
# stream ends. Recommended: sleeping mid-remux can corrupt the final file.
KEEP_AWAKE_DURING_PROCESSING=true
# Seconds between keep-awake checks.
KEEP_AWAKE_POLL_SECONDS=30
# Optional: wake the PC from suspend on a schedule (e.g. just before known
# stream times). Semicolon-separated systemd OnCalendar expressions.
# Example: WAKE_SCHEDULE=Mon,Wed,Fri 19:55;Sat 13:55
WAKE_SCHEDULE=
# After a scheduled wake, stay awake this many minutes waiting for the stream.
WAKE_HOLD_MINUTES=30

# ---- Misc -------------------------------------------------------------------
TZ=America/New_York
# Web UI: http://127.0.0.1:4800  (set WEB_BIND=0.0.0.0 to allow LAN access)
WEB_BIND=127.0.0.1
WEB_PORT=4800
# Set true if ARCHIVE_DIR is on storage that doesn't support chown (NFS/SMB).
SKIP_CHOWN=false
